# Configuración de Credenciales Seguras

# ===== BBVA MÓXICO =====
# URL base de API BBVA
BBVA_API_URL=https://api.bbva.mx

# Clave API de BBVA (obtener del portal de desarrolladores BBVA)
BBVA_API_KEY=tu_bbva_api_key_aqui

# ID de usuario BBVA
BBVA_USER_ID=tu_bbva_user_id_aqui

# ===== SANTANDER MÓXICO =====
# URL base de API Santander
SANTANDER_API_URL=https://api.santander.com.mx

# Clave API de Santander (obtener del portal de desarrolladores Santander)
SANTANDER_API_KEY=tu_santander_api_key_aqui

# ID de cuenta Santander
SANTANDER_ACCOUNT_ID=tu_santander_account_id_aqui

# ===== CONFIGURACIÓN GENERAL =====
# Propietario de las cuentas
PROPIETARIO=Juan Davila Camarillo

# RFC
RFC=DACJ871001KTA

# Zona horaria
TIMEZONE=America/Mexico_City

# ===== NOTAS IMPORTANTES =====
# 1. NUNCA subas este archivo con datos reales a GitHub
# 2. Agregálo a .gitignore para protegerlo
# 3. Para obtener credenciales:
#    - BBVA: https://developer.bbva.com
#    - Santander: https://developer.santander.com
# 4. Usa este archivo solo en tu máquina local
# 5. Mantén tus credenciales seguras y privadas
